# ==============================================================================
# CosmicLens AI — Environment Configuration Template
# Unified 100% Next.js Architecture (1-Click Vercel Deployment)
# Duplicate this file to .env and populate with your production or local secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# 2. AI ENGINE (Google Gemini)
# ------------------------------------------------------------------------------
# Get your Gemini API Key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Lovable AI Gateway key (if running inside Lovable editor environment)
LOVABLE_API_KEY=

# ------------------------------------------------------------------------------
# 3. DETERMINISTIC CACHE & RATE LIMITING (Upstash Redis)
# ------------------------------------------------------------------------------
# Create a free database at: https://upstash.com/
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ------------------------------------------------------------------------------
# 4. DATABASE & AUTHENTICATION (Supabase)
# ------------------------------------------------------------------------------
# Create a free project at: https://supabase.com/
# Public client-side URL & Anon key (prefixed with NEXT_PUBLIC_ for client visibility)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Server-side only (Private Service Role Key - NEVER expose to frontend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAYS (Stripe & Razorpay — Phase 4)
# ------------------------------------------------------------------------------
# Stripe: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay: https://dashboard.razorpay.com/#/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
